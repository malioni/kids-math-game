; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="kids-math-game"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
config/auto_accept_quit=false

[physics]

3d/physics_engine="Jolt Physics"

[autoload]

GameRegistry="*res://scripts/autoloads/game_registry.gd"
Progression="*res://scripts/autoloads/progression.gd"
SaveManager="*res://scripts/autoloads/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/initial_screen=0
window/handheld/orientation="landscape"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
